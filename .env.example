# ==============================================
# AdsX Environment Variables
# ==============================================
# Copy this file to .env and fill in your values

# ------------------------------------------
# Resend (Email Service)
# ------------------------------------------
# Get your API key from: https://resend.com/api-keys
# Free tier: 3,000 emails/month
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Email address to receive contact form submissions
CONTACT_EMAIL=hello@adsx.com

# From address for outgoing emails (must be verified domain in Resend)
FROM_EMAIL=hello@adsx.com

# ------------------------------------------
# Google Analytics (Optional)
# ------------------------------------------
# Get your measurement ID from Google Analytics 4
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------
# Google Search Console (Optional)
# ------------------------------------------
# Verification code for Google Search Console
# Add this to layout.tsx verification.google field
# GOOGLE_SITE_VERIFICATION=your-verification-code

# --- GSC API pipeline (scripts/gsc-*.mjs) — see GSC-SETUP.md ---
# Which property to pull. Leave unset to auto-detect (prefers a domain property).
# Domain property:     sc-domain:adsx.com
# URL-prefix property: https://www.adsx.com/
# GSC_SITE_URL=sc-domain:adsx.com
#
# AUTH — pick ONE. OAuth is recommended (works even when the org blocks SA keys):
#   run `npm run gsc:auth` once; it writes gsc-oauth.json (git-ignored) and the
#   pipeline picks it up automatically. For CI, set these three as GitHub secrets:
# GSC_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GSC_OAUTH_CLIENT_SECRET=xxxxx
# GSC_OAUTH_REFRESH_TOKEN=1//xxxxx
#
# Service-account alternative (no org key restriction): drop the JSON key at
# ./gsc-sa-key.json (git-ignored), or point GSC_SA_KEY_FILE at it. CI uses GSC_SA_KEY.
# GSC_SA_KEY_FILE=gsc-sa-key.json
#
# Optional: model for the nightly Claude plan (defaults to claude-opus-4-8).
# GSC_REVIEW_MODEL=claude-opus-4-8
