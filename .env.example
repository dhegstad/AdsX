# ==============================================
# AdsX Environment Variables
# ==============================================
# Copy this file to .env and fill in your values

# ------------------------------------------
# Resend (Email Service)
# ------------------------------------------
# Get your API key from: https://resend.com/api-keys
# Free tier: 3,000 emails/month
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Email address to receive contact form submissions
CONTACT_EMAIL=hello@adsx.com

# From address for outgoing emails (must be verified domain in Resend)
FROM_EMAIL=hello@adsx.com

# ------------------------------------------
# Google Analytics (Optional)
# ------------------------------------------
# Get your measurement ID from Google Analytics 4
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------
# Google Search Console (Optional)
# ------------------------------------------
# Verification code for Google Search Console
# Add this to layout.tsx verification.google field
# GOOGLE_SITE_VERIFICATION=your-verification-code

# --- GSC API pipeline (scripts/gsc-*.mjs) — see GSC-SETUP.md ---
# Which property to pull. Leave unset to auto-detect (prefers a domain property).
# Domain property:     sc-domain:adsx.com
# URL-prefix property: https://www.adsx.com/
# GSC_SITE_URL=sc-domain:adsx.com
#
# AUTH — pick ONE. OAuth is recommended (works even when the org blocks SA keys):
#   run `npm run gsc:auth` once; it writes gsc-oauth.json (git-ignored) and the
#   pipeline picks it up automatically. For CI, set these three as GitHub secrets:
# GSC_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GSC_OAUTH_CLIENT_SECRET=xxxxx
# GSC_OAUTH_REFRESH_TOKEN=1//xxxxx
#
# Service-account alternative (no org key restriction): drop the JSON key at
# ./gsc-sa-key.json (git-ignored), or point GSC_SA_KEY_FILE at it. CI uses GSC_SA_KEY.
# GSC_SA_KEY_FILE=gsc-sa-key.json
#
# Optional: model for the nightly Claude plan (defaults to claude-opus-4-8).
# GSC_REVIEW_MODEL=claude-opus-4-8

# ------------------------------------------
# X (Twitter) blog auto-poster (scripts/x-*.mjs) — see X-AUTOPOST-SETUP.md
# ------------------------------------------
# Master kill switch. Nothing posts unless this is exactly "true".
# In CI, set this as a repo *Variable* so you can flip it in the GitHub UI.
# X_AUTOPOST_ENABLED=false
#
# OAuth 2.0 app credentials (X developer portal → your app → User auth settings).
# Run `npm run x:auth` once; it writes x-oauth.json (git-ignored), seeds the
# refresh token into Neon, and prints the three CI secrets to add.
# X_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxx
# X_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxx
# X_OAUTH_REFRESH_TOKEN=xxxxx   # seed only; the rotating token then lives in the DB
#
# Reused by the poster: DATABASE_URL (ledger + token), ANTHROPIC_API_KEY (copy),
# RESEND_API_KEY + CONTACT_EMAIL/FROM_EMAIL (daily summary email), SITE_URL.
#
# Optional tuning (safe defaults shown):
# X_MAX_PER_RUN=1            # posts per scheduled run (keep low for account health)
# X_BACKFILL_MIN_CLICKS=3    # only backfill posts with >= this many GSC clicks
# X_FRESH_DAYS=14            # posts newer than this jump the queue
# X_COPY_MODEL=claude-sonnet-5
# X_HANDLE=adsxcom

# ------------------------------------------
# Email nurture drip (scripts/nurture-*.mjs) — see EMAIL-NURTURE-SETUP.md
# ------------------------------------------
# Master kill switch. Nothing sends unless this is exactly "true".
# In CI, set this as a repo *Variable* so you can flip it in the GitHub UI.
# NURTURE_ENABLED=false
#
# Reuses DATABASE_URL (subscriber state), RESEND_API_KEY + FROM_EMAIL (sending),
# and SITE_URL (unsubscribe links).
#
# CAN-SPAM REQUIRES a real physical postal address in every email. Set this
# before enabling the drip — the default is an obvious placeholder.
# BUSINESS_POSTAL_ADDRESS=AdsX, 123 Example St, City, ST 00000
#
# Optional 2nd affiliate offer (see SECOND-AFFILIATE-OFFER-BRIEF.md — recommended
# pick is Spocket via PartnerStack: recurring, allows non-branded paid search +
# direct-linking, complements Shopify). When set, the final nurture email
# recommends it; when unset, that email links internally (never invents a URL).
# SECOND_AFFILIATE_LINK=<your PartnerStack Spocket link>
# SECOND_AFFILIATE_NAME=Spocket
#
# Optional tuning (safe defaults in nurture-lib.mjs):
# NURTURE_MAX_PER_RUN=200
# NURTURE_SEND_DELAY_MS=600
